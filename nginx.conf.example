# Example nginx site config for AquaTerm orderbook API.
#
# Public URL:  https://my-test-server.ru/aqua-term/api/orderbook
# Flask app:   http://127.0.0.1:5001/api/orderbook  (no path prefix in the app)
#
# Install (Debian/Ubuntu):
#   sudo cp nginx.conf.example /etc/nginx/sites-available/aqua-term
#   sudo ln -sf /etc/nginx/sites-available/aqua-term /etc/nginx/sites-enabled/aqua-term
#   sudo nginx -t && sudo systemctl reload nginx
#
# CORS is handled by Flask (see CORS_ORIGINS in .env).
# The trailing slash on proxy_pass is required to strip /aqua-term/ before forwarding.

upstream aqua_term_app {
    server 127.0.0.1:5001;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name my-test-server.ru;

    # ssl_certificate     /etc/letsencrypt/live/my-test-server.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/my-test-server.ru/privkey.pem;

    # Optional: redirect HTTP → HTTPS
    # server {
    #     listen 80;
    #     listen [::]:80;
    #     server_name my-test-server.ru;
    #     return 301 https://$host$request_uri;
    # }

    location /aqua-term/ {
        proxy_pass http://aqua_term_app/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
