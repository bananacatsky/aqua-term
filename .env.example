# Deploy (Foundry)
# PRIVATE_KEY=0x...
# BASESCAN_API_KEY=...
# ETHERSCAN_API_KEY=...

# Live Sepolia integration test (off by default; see test/live/SepoliaLive.t.sol)
# AQUATERM_SEPOLIA_LIVE=1
# AQUATERM_SEPOLIA_LIVE=1 forge test --match-path test/live/SepoliaLive.t.sol --rpc-url sepolia --broadcast -vvv

# RPC (same keys as ../w/.env)
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
HTTP_TIMEOUT=30

# Server
PORT=5001
FLASK_DEBUG=0
# Public path prefix /aqua-term/ is handled by nginx; see nginx.conf.example
CORS_ORIGINS=https://bananacatsky.github.io
ORDERBOOK_DB=orderbook.db
SYNC_INTERVAL_SECONDS=12
SYNC_BLOCK_CHUNK=2000
SYNC_MAX_AGE_SECONDS=2592000
REFRESH_OPEN_ORDERS=true

# Apps to index: address:chain:from_block[:maturity_ts,maturity_ts,...] (semicolon-separated)
# AQUATERM_APPS=0xYourAquaTermApp:ethereum:21000000:1735689600,1738368000
# Sepolia example:
# AQUATERM_APPS=0xAbefa1Fc085b81eE67a27C4B37c6c6c29CbA7d2E:sepolia:11788387:1793318400,1795996800,1798675200,1801353600
