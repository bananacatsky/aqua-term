# Deploy (Foundry)
# PRIVATE_KEY=0x...
# BASESCAN_API_KEY=...
# ETHERSCAN_API_KEY=...

# Live Sepolia integration test (off by default; see test/live/SepoliaLive.t.sol)
# AQUATERM_SEPOLIA_LIVE=1
# AQUATERM_SEPOLIA_LIVE=1 forge test --match-path test/live/SepoliaLive.t.sol --rpc-url sepolia --broadcast -vvv

# RPC (same keys as ../w/.env)
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
HTTP_TIMEOUT=30

# Frontend (Vite reads this .env: cd frontend && npm run dev|build)
# Real indexer (default). Mock is python server/mock_app.py on :5002.
# AQUA_API_BASE=http://127.0.0.1:5001/api
# AQUA_API_BASE=http://127.0.0.1:5002/api
# AQUA_API_BASE=/api
# AQUA_API_BASE=https://my-test-server.ru/aqua-term/api
# Optional; chain + app default to the first AQUATERM_APPS entry.
# AQUA_CHAIN=sepolia
# AQUA_APP_ADDRESS=0xYourAquaTermApp
# AQUA_DEBT_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# AQUA_TOKEN_USDT=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# AQUA_TOKEN_WETH=0x7b79995e5f793A07Bc00c21412e50Ecae098E7f9
# AQUA_TOKEN_WBTC=0xE47dE7c2c4d24198Ff8f3bC3a1d3C529c67925BD

# Server
PORT=5001
FLASK_DEBUG=0
# Public path prefix /aqua-term/ is handled by nginx; see nginx.conf.example
CORS_ORIGINS=https://bananacatsky.github.io,http://127.0.0.1:5173,http://localhost:5173
ORDERBOOK_DB=orderbook.db
SYNC_INTERVAL_SECONDS=12
SYNC_BLOCK_CHUNK=2000
SYNC_MAX_AGE_SECONDS=2592000
REFRESH_OPEN_ORDERS=true

# Apps to index: address:chain:from_block[:maturity_ts,maturity_ts,...] (semicolon-separated)
# AQUATERM_APPS=0xYourAquaTermApp:ethereum:21000000:1735689600,1738368000
# Sepolia example:
# AQUATERM_APPS=0xAbefa1Fc085b81eE67a27C4B37c6c6c29CbA7d2E:sepolia:11788387:1793318400,1795996800,1798675200,1801353600
